// Prisma Schema for AI Interview Practice

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum SessionState {
  CREATED
  ACTIVE
  EVALUATING
  COMPLETED
  CANCELLED
  FAILED
}

enum LearningPathStatus {
  PENDING
  READY
  FAILED
}

enum AiRunStatus {
  SUCCESS
  FAILED
}

enum SessionMode {
  STANDARD
  FOCUSED_REMEDIATION
  QUICK_PRACTICE
  CODING
  BEHAVIORAL
  VOICE_LIVE
  SYSTEM_DESIGN
}

enum CompetencyArea {
  SYSTEM_DESIGN
  LANGUAGE_CORE
  DATABASE_CONCURRENCY
  ARCHITECTURE_PATTERNS
  RESILIENCE_SECURITY
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         UserRole      @default(CANDIDATE)
  status       UserStatus    @default(ACTIVE)
  lockedAt     DateTime?     @map("locked_at")
  lockReason   String?       @map("lock_reason") @db.VarChar(255)
  mfaSecret    String?       @map("mfa_secret") @db.VarChar(255)
  mfaEnabled   Boolean       @default(false) @map("mfa_enabled")
  tokenVersion Int           @default(0) @map("token_version")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  profile         UserProfile?
  refreshTokens   RefreshToken[]
  recoveryCodes   RecoveryCode[]
  sessions        InterviewSession[]
  auditLogs       AuditLog[]
  idempotencies   IdempotencyRecord[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  usageRecords    UsageRecord[]
  documents       UserDocument[]
  jdAnalyses      JdAnalysis[]
  tutorSessions   TutorSession[]
  questionRetries QuestionRetry[]
  flashcardDecks  FlashcardDeck[]
  userStreak      UserStreak?
  skillScores     SkillScore[]
  readinessSnapshots ReadinessSnapshot[]
  readinessMilestones ReadinessMilestone[]
  publicPortfolio   PublicPortfolio?
  userBadges        UserBadge[]
  certificates      Certificate[]
  mentorProfile     MentorProfile?
  candidateLiveSessions LiveSession[]   @relation("CandidateUserSessions")
  tenantMembers     TenantMember[]
  userXp            UserXp?
  xpTransactions    XpTransaction[]
  badgeUnlocks      UserBadgeUnlock[]
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?
  fileAssets        FileAsset[]
  voiceConsentRecords VoiceConsentRecord[]
  entitlementBuckets EntitlementBucket[]
  entitlementReservations EntitlementReservation[]
  createdQuestions   QuestionBankQuestion[]        @relation("CreatedQuestions")
  reviewedAnswers    QuestionBankAnswer[]          @relation("ReviewedAnswers")
  questionAccessGrants QuestionAnswerAccessGrant[]
  questionUsageLedgers QuestionBankUsageLedger[]
  questionBookmarks   QuestionBookmark[]
  questionFeedbacks   QuestionFeedback[]
  configurationPresets InterviewConfigurationPreset[]
  recentConfigurations RecentInterviewConfiguration[]
  interviewSetupDrafts InterviewSetupDraft[]
  arenaChallengesCreated EngineeringChallenge[]        @relation("ArenaCreatedChallenges")
  arenaSessions       ArenaSession[]
  arenaSkillEvidences ArenaSkillEvidence[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(100)
  targetRole  String?  @map("target_role") @db.VarChar(100)
  targetLevel String?  @map("target_level") @db.VarChar(50)
  bio         String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  familyId    String   @default(uuid()) @map("family_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.VarChar(255)
  isRevoked   Boolean  @default(false) @map("is_revoked")
  mfaVerified Boolean  @default(false) @map("mfa_verified")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model JobRole {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions              InterviewSession[]
  questionBankQuestions QuestionBankQuestion[]
  configurationPresets  InterviewConfigurationPreset[]
  recentConfigurations  RecentInterviewConfiguration[]

  @@map("job_roles")
}

model SeniorityLevel {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  order       Int      @default(1)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions              InterviewSession[]
  questionBankQuestions QuestionBankQuestion[]
  configurationPresets  InterviewConfigurationPreset[]
  recentConfigurations  RecentInterviewConfiguration[]

  @@map("seniority_levels")
}

model Technology {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  category    String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessionTechnologies     SessionTechnology[]
  questionBankTechnologies QuestionBankTechnology[]

  @@map("technologies")
}

model InterviewSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  jobRoleId        String            @map("job_role_id") @db.Uuid
  seniorityLevelId String            @map("seniority_level_id") @db.Uuid
  state            SessionState      @default(CREATED)
  sessionMode      SessionMode       @default(STANDARD) @map("session_mode")
  competencyArea   CompetencyArea?   @map("competency_area")
  language         String            @default("vi") @db.VarChar(10)
  tenantId         String?           @map("tenant_id") @db.Uuid
  assignmentId     String?           @map("assignment_id") @db.Uuid
  isSandbox        Boolean           @default(false) @map("is_sandbox")
  currentTurn      Int               @default(1) @map("current_turn")
  totalTurns       Int               @default(5) @map("total_turns")
  targetDifficulty Int               @default(1) @map("target_difficulty") // 1: Easy, 2: Medium, 3: Hard
  overallScore     Float?            @map("overall_score")
  configurationSnapshot Json?        @map("configuration_snapshot")
  configurationSource String?        @map("configuration_source") @db.VarChar(50)
  fieldSources     Json?             @map("field_sources")
  draftId          String?           @map("draft_id") @db.Uuid
  presetId         String?           @map("preset_id") @db.Uuid
  completedAt      DateTime?         @map("completed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRole          JobRole           @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  seniorityLevel   SeniorityLevel    @relation(fields: [seniorityLevelId], references: [id], onDelete: Restrict)
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assignment       Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  technologies     SessionTechnology[]
  turns            InterviewTurn[]
  learningPath     LearningPath?
  aiRuns           AiRun[]
  shareTokens      ShareToken[]
  codeSubmissions  CodeSubmission[]
  codeTestCases    CodeTestCase[]
  voiceSession     VoiceSession?
  voiceConsentRecords VoiceConsentRecord[]
  systemDesignSession SystemDesignSession?
  liveMentorSessions LiveSession[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([assignmentId])
  @@index([state])
  @@index([sessionMode])
  @@map("interview_sessions")
}

model InterviewConfigurationPreset {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  name             String          @db.VarChar(100)
  description      String?         @db.Text
  fingerprint      String          @db.VarChar(64)
  jobRoleId        String          @map("job_role_id") @db.Uuid
  seniorityLevelId String          @map("seniority_level_id") @db.Uuid
  technologyIds    String[]        @map("technology_ids")
  sessionMode      SessionMode     @default(STANDARD) @map("session_mode")
  competencyArea   CompetencyArea? @map("competency_area")
  language         String          @default("vi") @db.VarChar(10)
  totalTurns       Int             @default(5) @map("total_turns")
  isSandbox        Boolean         @default(false) @map("is_sandbox")
  isPinned         Boolean         @default(false) @map("is_pinned")
  blueprintId      String?         @map("blueprint_id") @db.Uuid
  useCount         Int             @default(0) @map("use_count")
  lastUsedAt       DateTime?       @map("last_used_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRole          JobRole         @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  seniorityLevel   SeniorityLevel  @relation(fields: [seniorityLevelId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@index([userId])
  @@map("interview_configuration_presets")
}

model RecentInterviewConfiguration {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  fingerprint      String          @db.VarChar(64)
  jobRoleId        String          @map("job_role_id") @db.Uuid
  seniorityLevelId String          @map("seniority_level_id") @db.Uuid
  technologyIds    String[]        @map("technology_ids")
  sessionMode      SessionMode     @default(STANDARD) @map("session_mode")
  competencyArea   CompetencyArea? @map("competency_area")
  language         String          @default("vi") @db.VarChar(10)
  totalTurns       Int             @default(5) @map("total_turns")
  isSandbox        Boolean         @default(false) @map("is_sandbox")
  blueprintId      String?         @map("blueprint_id") @db.Uuid
  useCount         Int             @default(1) @map("use_count")
  lastUsedAt       DateTime        @default(now()) @map("last_used_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRole          JobRole         @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  seniorityLevel   SeniorityLevel  @relation(fields: [seniorityLevelId], references: [id], onDelete: Restrict)

  @@unique([userId, fingerprint])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("recent_interview_configurations")
}

model InterviewSetupDraft {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  cvProfileId        String?         @map("cv_profile_id") @db.Uuid
  jdProfileId        String?         @map("jd_profile_id") @db.Uuid
  selectedPresetId   String?         @map("selected_preset_id") @db.Uuid
  extractedProfile   Json?           @map("extracted_profile")
  configurationDraft Json            @map("configuration_draft")
  fieldSources       Json            @map("field_sources")
  status             String          @default("ACTIVE") @db.VarChar(30)
  expiresAt          DateTime?       @map("expires_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("interview_setup_drafts")
}

model SessionTechnology {
  sessionId    String           @map("session_id") @db.Uuid
  technologyId String           @map("technology_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  technology   Technology       @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([sessionId, technologyId])
  @@map("session_technologies")
}

model InterviewTurn {
  id               String           @id @default(uuid()) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  turnNumber       Int              @map("turn_number") // 1 to 5
  difficulty       Int              @default(1) // 1 to 3
  status           String           @default("PENDING") @db.VarChar(30) // PENDING, QUESTION_READY, ANSWER_SUBMITTED, EVALUATED, FAILED
  isFollowUp       Boolean          @default(false) @map("is_follow_up")
  parentTurnNumber Int?             @map("parent_turn_number")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question?
  answer           Answer?

  @@unique([sessionId, turnNumber])
  @@index([sessionId])
  @@map("interview_turns")
}

model Question {
  id             String        @id @default(uuid()) @db.Uuid
  turnId         String        @unique @map("turn_id") @db.Uuid
  content        String        @db.Text
  keyFocus       String?       @map("key_focus") @db.VarChar(255)
  expectedPoints Json?         @map("expected_points")
  difficulty     Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")

  turn           InterviewTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model Answer {
  id          String        @id @default(uuid()) @db.Uuid
  turnId      String        @unique @map("turn_id") @db.Uuid
  content     String        @db.VarChar(5000)
  submittedAt DateTime      @default(now()) @map("submitted_at")

  turn        InterviewTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  evaluation  Evaluation?
  starEvaluation StarEvaluation?

  @@map("answers")
}

model Evaluation {
  id              String   @id @default(uuid()) @db.Uuid
  answerId        String   @unique @map("answer_id") @db.Uuid
  score           Float    // 0.0 to 10.0
  rubricScores    Json     @map("rubric_scores") // { technicalAccuracy: number, depth: number, clarity: number }
  strengths       Json     // string[]
  improvements    Json     // string[]
  conciseFeedback String   @map("concise_feedback") @db.Text
  evidence        Json     // string[]
  needsReview     Boolean  @default(false) @map("needs_review")
  authorityState  String   @default("AUTHORITATIVE") @map("authority_state") @db.VarChar(30)
  provider        String?  @db.VarChar(50)
  fallbackReason  String?  @map("fallback_reason") @db.VarChar(255)
  confidence      Float?
  currentRunId    String?  @map("current_run_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  answer          Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  runs            EvaluationRun[]

  @@map("evaluations")
}

// Immutable evaluation run history (F-010 audit finding)
model EvaluationRun {
  id              String   @id @default(uuid()) @db.Uuid
  evaluationId    String   @map("evaluation_id") @db.Uuid
  runNumber       Int      @map("run_number")
  score           Float
  rubricScores    Json     @map("rubric_scores")
  strengths       Json
  improvements    Json
  conciseFeedback String   @map("concise_feedback") @db.Text
  evidence        Json
  needsReview     Boolean  @default(false) @map("needs_review")
  authorityState  String   @default("AUTHORITATIVE") @map("authority_state") @db.VarChar(30)
  provider        String?  @db.VarChar(50)
  model           String?  @db.VarChar(100)
  fallbackReason  String?  @map("fallback_reason") @db.VarChar(255)
  confidence      Float?
  promptVersionId String?  @map("prompt_version_id") @db.Uuid
  rubricVersion   String?  @map("rubric_version") @db.VarChar(50)
  triggeredBy     String   @default("SYSTEM") @map("triggered_by") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")

  evaluation      Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@unique([evaluationId, runNumber])
  @@index([evaluationId])
  @@map("evaluation_runs")
}

model LearningPath {
  id           String             @id @default(uuid()) @db.Uuid
  sessionId    String             @unique @map("session_id") @db.Uuid
  status       LearningPathStatus @default(PENDING)
  summary      String?            @db.Text
  errorMessage String?            @map("error_message") @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  session      InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items        LearningPathItem[]

  @@map("learning_paths")
}

model LearningPathItem {
  id                String       @id @default(uuid()) @db.Uuid
  learningPathId    String       @map("learning_path_id") @db.Uuid
  gap               String       @db.VarChar(255)
  topic             String       @db.VarChar(255)
  priority          String       @db.VarChar(20) // HIGH, MEDIUM, LOW
  recommendedAction String       @map("recommended_action") @db.Text
  searchKeywords    Json         @map("search_keywords") // string[]
  order             Int          @default(0)
  isCompleted       Boolean      @default(false) @map("is_completed")
  completedAt       DateTime?    @map("completed_at")

  learningPath      LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@index([learningPathId, order])
  @@map("learning_path_items")
}

model PromptVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @db.VarChar(50) // question_generator, answer_evaluator, learning_path
  version            Int      @default(1)
  systemPrompt       String   @map("system_prompt") @db.Text
  userPromptTemplate String   @map("user_prompt_template") @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  aiRuns             AiRun[]
  evaluationRuns     EvaluationRun[]

  @@unique([slug, version])
  @@map("prompt_versions")
}

model AiRun {
  id               String            @id @default(uuid()) @db.Uuid
  sessionId        String?           @map("session_id") @db.Uuid
  promptVersionId  String?           @map("prompt_version_id") @db.Uuid
  provider         String            @db.VarChar(50) // mock, openai, anthropic, gemini
  model            String            @db.VarChar(100)
  promptTokens     Int?              @map("prompt_tokens")
  completionTokens Int?              @map("completion_tokens")
  totalTokens      Int?              @map("total_tokens")
  latencyMs        Int               @map("latency_ms")
  costEstimate     Float?            @map("cost_estimate")
  status           AiRunStatus       @default(SUCCESS)
  errorCode        String?           @map("error_code") @db.VarChar(50)
  metadata         Json?
  createdAt        DateTime          @default(now()) @map("created_at")

  session          InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  promptVersion    PromptVersion?    @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([provider, status])
  @@map("ai_runs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(255)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

model IdempotencyRecord {
  key            String   @id @db.VarChar(255)
  userId         String   @map("user_id") @db.Uuid
  resource       String   @db.VarChar(100)
  requestHash    String?  @map("request_hash") @db.VarChar(64)
  status         String   @default("COMPLETED") @db.VarChar(20) // IN_PROGRESS, COMPLETED, FAILED
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model ShareToken {
  id           String           @id @default(uuid()) @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  token        String           @unique @db.VarChar(64)
  passcodeHash String?          @map("passcode_hash") @db.VarChar(255)
  isRevoked    Boolean          @default(false) @map("is_revoked")
  isAnonymized Boolean          @default(false) @map("is_anonymized")
  expiresAt    DateTime?        @map("expires_at")
  viewCount    Int              @default(0) @map("view_count")
  lastViewedAt DateTime?        @map("last_viewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mentorFeedback MentorFeedback[]

  @@index([sessionId])
  @@index([token])
  @@map("share_tokens")
}

model MentorFeedback {
  id           String     @id @default(uuid()) @db.Uuid
  shareTokenId String     @map("share_token_id") @db.Uuid
  turnNumber   Int?       @map("turn_number")
  mentorName   String     @map("mentor_name") @db.VarChar(100)
  comment      String     @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  shareToken   ShareToken @relation(fields: [shareTokenId], references: [id], onDelete: Cascade)

  @@index([shareTokenId])
  @@map("mentor_feedbacks")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ----------------------------------------------------
// F013: Semantic Cache & LLM Fallback Router Models
// ----------------------------------------------------

model SemanticCache {
  id              String   @id @default(uuid()) @db.Uuid
  namespace       String?  @db.VarChar(100)
  userId          String?  @map("user_id") @db.Uuid
  promptHash      String   @unique @map("prompt_hash") @db.VarChar(64)
  promptText      String   @map("prompt_text") @db.Text
  embedding       Float[]
  responsePayload Json     @map("response_payload")
  metadata        Json?
  hitCount        Int      @default(0) @map("hit_count")
  ttlSeconds      Int      @default(86400) @map("ttl_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  lastUsedAt      DateTime @default(now()) @map("last_used_at")

  @@index([promptHash])
  @@index([namespace])
  @@index([userId])
  @@map("semantic_cache")
}

model ProviderHealthLog {
