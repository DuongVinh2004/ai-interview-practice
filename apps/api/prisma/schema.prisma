enum LiveSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum MentorAuthorityState {
  PENDING
  APPROVED
  SUSPENDED
  REVOKED
}

model MentorProfile {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @unique @map("user_id") @db.Uuid
  expertiseAreas String[]             @map("expertise_areas")
  rating         Float                @default(0.0)
  totalSessions  Int                  @default(0) @map("total_sessions")
  bio            String?              @db.Text
  isActive       Boolean              @default(false) @map("is_active")
  authorityState MentorAuthorityState @default(PENDING) @map("authority_state")
  approvedAt     DateTime?            @map("approved_at")
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  authorityChangedAt DateTime         @default(now()) @map("authority_changed_at")
  authorityChangedByUserId String?    @map("authority_changed_by_user_id") @db.Uuid
  authorityReason String?             @map("authority_reason") @db.VarChar(500)
