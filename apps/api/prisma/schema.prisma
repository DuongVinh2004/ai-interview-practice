  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations EntitlementReservation[]

  @@unique([userId, metric, accessPeriodKey])
  @@index([resetsAt])
  @@map("entitlement_buckets")
}

model EntitlementReservation {
  id                  String                    @id @default(uuid()) @db.Uuid
  bucketId            String                    @map("bucket_id") @db.Uuid
  userId              String                    @map("user_id") @db.Uuid
  metric              String                    @db.VarChar(100)
  accessPeriodKey     String                    @map("access_period_key") @db.VarChar(100)
  idempotencyKey      String                    @map("idempotency_key") @db.VarChar(255)
  requestFingerprint  String                    @map("request_fingerprint") @db.VarChar(64)
  operationType       String                    @map("operation_type") @db.VarChar(100)
  operationId         String?                   @map("operation_id") @db.VarChar(255)
  estimatedQuantity   Int                       @map("estimated_quantity")
  actualQuantity      Int?                      @map("actual_quantity")
  state               EntitlementReservationState @default(RESERVED)
  expiresAt           DateTime                  @map("expires_at")
  providerDispatchStartedAt DateTime?           @map("provider_dispatch_started_at")
  provider            String?                   @db.VarChar(100)
  providerOperationId String?                   @map("provider_operation_id") @db.VarChar(255)
  resolutionReason    String?                   @map("resolution_reason") @db.VarChar(500)
  reconciliationData  Json?                     @map("reconciliation_data")
  reconciledAt        DateTime?                 @map("reconciled_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  bucket EntitlementBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecord UsageRecord? @relation("ReservationUsageRecord")

  @@unique([userId, metric, accessPeriodKey, idempotencyKey])
  @@index([state, expiresAt])
  @@index([operationType, operationId])
  @@map("entitlement_reservations")
}

