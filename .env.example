# ==============================================
# AI Interview Practice Environment Configuration
# ==============================================

# Node Environment
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interview_practice?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview_practice
POSTGRES_PORT=5432

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_ACCESS_SECRET="super-secret-access-key-minimum-32-chars-for-dev"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-minimum-32-chars-for-dev"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# AI Provider Configuration
# Options: mock | external
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=mock-model-v1
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Demo Accounts (Initialized during db:seed)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_CANDIDATE_EMAIL=candidate@example.com
DEMO_CANDIDATE_PASSWORD=Candidate@123456
