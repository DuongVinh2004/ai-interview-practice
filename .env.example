# Environment Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Minimum 32 chars recommended)
JWT_ACCESS_SECRET=dev-jwt-access-secret-32-characters-minimum-length-ok
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-32-characters-minimum-length-ok
JWT_REFRESH_EXPIRATION=7d

# Throttling / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# AI Provider Configuration
# Options: mock | gemini | openai | anthropic | router
AI_PROVIDER=mock

# AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Model Overrides
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AI Routing & Resilience
AI_PROVIDER_PRIORITY=gemini,openai,anthropic,mock
AI_BUDGET_DAILY_USD=50.0
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2

# Demo Seed Credentials
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_CANDIDATE_EMAIL=candidate@example.com
DEMO_CANDIDATE_PASSWORD=Candidate@123456
