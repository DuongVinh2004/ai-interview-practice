# ==============================================================================
# AI Interview Practice — Environment Configuration (.env.example)
# All sensitive credentials MUST use placeholders. Do NOT commit real secrets!
# ==============================================================================

# ── Application Environment & Server ──
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
PROCESS_ROLE=all # Options: all | api | worker

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview
POSTGRES_PORT=5432

# ── Redis & BullMQ Queue ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT Authentication & Security Secrets (Min 32 characters) ──
JWT_ACCESS_SECRET=dev-jwt-access-secret-32-characters-minimum-length-ok
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-32-characters-minimum-length-ok
JWT_REFRESH_EXPIRATION=7d
MFA_ENCRYPTION_KEY=dev-mfa-encryption-key-min-32-chars-ok
CERTIFICATE_SECRET=development-only-certificate-secret-not-for-production

# ── Throttling & Rate Limiting ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_REFRESH_THROTTLE_LIMIT=60

# ── Observability & Prometheus Metrics Exporter (REL-001 / OPS-001) ──
METRICS_EXPORTER_ENABLED=false
METRICS_EXPORTER_HOST=0.0.0.0
METRICS_EXPORTER_PORT=9091
METRICS_AUTH_TOKEN=dev-metrics-token-placeholder

# ── AI Provider Configuration & Resiliency ──
# Options: mock | gemini | openai | anthropic | router
AI_PROVIDER=mock
AI_MODEL_NAME=gemini-2.0-flash
AI_PROVIDER_PRIORITY=gemini,openai,anthropic,mock
AI_BUDGET_DAILY_USD=50.0
AI_MAX_PROVIDER_CALL_COST_USD=2.0
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2

# Fail-closed guard for production environments
AI_ALLOW_MOCK=false
ALLOW_MOCK_PROVIDERS=false

# AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI Model Overrides
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── 9Router AI Gateway (Local/VPS) ──
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
NINEROUTER_STT_MODEL=groq/whisper-large-v3-turbo
NINEROUTER_TTS_MODEL=edge-tts/vi-VN-HoaiMyNeural

# ── Demo Seed Credentials (Non-production testing only) ──
DEMO_ADMIN_EMAIL=admin@yourorg.com
DEMO_ADMIN_PASSWORD=change-me-to-a-secure-password
DEMO_CANDIDATE_EMAIL=candidate@yourorg.com
DEMO_CANDIDATE_PASSWORD=change-me-to-a-secure-password

# ── Module B1: Cloud Object Storage (S3 / Cloudflare R2 / Mock) ──
STORAGE_PROVIDER=mock # Options: mock | s3 | r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=ai-interview-assets
AWS_S3_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-interview-assets
R2_ENDPOINT=
R2_PUBLIC_URL=https://assets.ai-interview.dev
STORAGE_PUBLIC_CDN_URL=

# ── Module B2: Transactional Email System (Resend / Mock) ──
EMAIL_PROVIDER=mock # Options: mock | resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ai-interview.dev
RESEND_FROM_NAME="AI Interview Practice"
EMAIL_DEFAULT_FROM="AI Interview Practice <noreply@ai-interview.dev>"

# ── Module B3: Ultra-Low Latency Voice Pipeline (Deepgram + ElevenLabs) ──
VOICE_STT_PROVIDER=mock # Options: mock | deepgram
VOICE_TTS_PROVIDER=mock # Options: mock | elevenlabs | cartesia
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
CARTESIA_API_KEY=

# ── Module B4: PayOS VietQR & Live Billing (PayOS + Stripe) ──
# PayOS VietQR Configuration
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Stripe Live / Test Mode Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRICE_PRO=price_pro_monthly_placeholder
STRIPE_PRICE_TEAM=price_team_monthly_placeholder
STRIPE_PRICE_ENTERPRISE=price_enterprise_placeholder

# ── Module B5: Whiteboard Multimodal Vision AI (Gemini / OpenAI / Mock) ──
VISION_PROVIDER=mock # Options: mock | gemini | openai
GEMINI_VISION_MODEL=gemini-2.0-flash
OPENAI_VISION_MODEL=gpt-4o
VISION_DAILY_BUDGET_USD=5.0

# ── Feature F017: Engineering Arena Runtime (deterministic | docker) ──
ARENA_WORKSPACE_RUNTIME=deterministic
ARENA_DETERMINISTIC_FALLBACK=true

# ── Remote Code Execution Sandbox (Judge0) ──
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# ── Feature Toggles & Capabilities ──
FEATURE_SEMANTIC_CACHE=false
FEATURE_LIVE_CODING=false
FEATURE_BEHAVIORAL_INTERVIEW=false
FEATURE_BILLING=true
FEATURE_JD_RESUME_PARSER=false
FEATURE_SOCRATIC_TUTOR=false
FEATURE_SPACED_REPETITION=false
FEATURE_VOICE_STREAMING=false
FEATURE_QUESTION_BANK=true

# ── Web Push Notifications (VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ai-interview.dev

# ── Web Client (Vite) ──
VITE_API_BASE_URL=http://localhost:3001
