FROM node:22.13.1-bookworm-slim@sha256:83fdfa2a4de32d7f8d79829ea259bd6a4821f8b2d123204ac467fbe3966450fc

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI="true"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates openssl

RUN npm install --global --ignore-scripts corepack@0.34.0 \
    && corepack enable \
    && corepack prepare pnpm@11.0.9 --activate

WORKDIR /work

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter web exec playwright install --with-deps chromium

COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/web ./apps/web
COPY infra/testing/run-playwright-e2e.sh /usr/local/bin/run-playwright-e2e

RUN pnpm --filter contracts build \
    && pnpm --filter api exec prisma generate \
    && pnpm --filter api build \
    && chmod 0555 /usr/local/bin/run-playwright-e2e

ENTRYPOINT ["/usr/local/bin/run-playwright-e2e"]
