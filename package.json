{
  "name": "ai-interview-practice",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Practice - Production-grade modular monolith and client",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "22.13.x",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter api dev:worker",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter contracts build && pnpm --filter api build && pnpm --filter web build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "type-check": "pnpm --recursive run type-check",
    "test": "pnpm --filter contracts test && pnpm --filter api test && pnpm --filter web test",
    "test:unit": "pnpm --filter api test:unit && pnpm --filter web test",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  }
}
